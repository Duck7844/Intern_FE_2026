# Server-side base URL of the NestJS API (used by Server Components and route handlers)
API_URL=http://localhost:3000
# Browser-side base URL of the API (contact form submissions, uploaded image URLs)
NEXT_PUBLIC_API_URL=http://localhost:3000
# Public URL of the website (Open Graph / social image URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
